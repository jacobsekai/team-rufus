# Copy this file to .env for local development.
# Never commit .env or long-lived AWS access keys.

AWS_REGION=us-west-2
# Set this only if your approved AWS profile is not the default profile.
# AWS_PROFILE=your-approved-profile

DYNAMODB_TABLE_NAME=t-level-expressions-of-interest-dev
USERS_TABLE_NAME=t-level-users-dev
SESSIONS_TABLE_NAME=t-level-sessions-dev

# Private S3 bucket for downloadable content (printed by deploy/deploy.sh).
# CONTENT_BUCKET_NAME=

# Sign-in sessions last this many hours.
SESSION_HOURS=12

# Flask only listens on loopback by default.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0

